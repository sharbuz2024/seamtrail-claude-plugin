{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/start.sh", "timeout": 15}
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/tickets.sh person", "timeout": 5},
          {"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/message.sh", "timeout": 6}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/guard.sh", "timeout": 5}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*__(remember|resolve|settle_question|widen_memory)$",
        "hooks": [
          {"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/saved.sh", "timeout": 5}
        ]
      },
      {
        "matcher": "mcp__.*__(ask_seamtrail|undo_change)$",
        "hooks": [
          {"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/saved.sh change", "timeout": 5}
        ]
      },
      {
        "matcher": "mcp__.*__set_chat_project$",
        "hooks": [
          {"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/picked.sh", "timeout": 5}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/stop.sh", "timeout": 5},
          {"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/tickets.sh claude", "timeout": 5}
        ]
      }
    ]
  }
}
